# Neon connection string (use the pooled one). Leave unset locally to use the embedded database.
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Long random string used to sign session cookies: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Company timezone for attendance days (IANA name)
APP_TIMEZONE=Asia/Karachi
